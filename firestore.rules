rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: Firebase Auth uid
// Fields:
//   - displayName: string (required, 0-100 chars)
//   - email: string (required, equals the sign-in email or "")
//   - photoURL: string (required, "" or a https://lh3.googleusercontent.com/ URL, max 500 chars)
//   - approved: bool (required, true on create; admins can revoke it)
//   - admin: bool (required; false on create, except the site owner may
//     create their own profile with true; otherwise changed only in the console)
//   - createdAt: timestamp (required, server time on create, immutable)
//   Clients may create their own profile once, only via verified Google
//   sign-in, and never update or delete it.
//   Admins may read all profiles and change only the `approved` flag
//   (from admin/index.html). The `admin` flag is only changed in the console.
//
// Subcollection: users/{uid}/comments
// Document ID: auto id
// Fields:
//   - chapterId: string (required, 1-100 chars, immutable)
//   - paragraphIndex: int (required, 0-5000, immutable)
//   - text: string (required, 1-2000 chars)
//   - createdAt: timestamp (required, server time on create, immutable)
//   - updatedAt: timestamp (required, server time on every write)
//   Only the owning, approved user can create or edit, and each create or edit
//   must advance the daily quota below in the same batch. The owner and admins
//   can read (admins via a collection group query on "comments"). The approved
//   owner and admins can delete (admins remove spam).
//
// Subcollection: users/{uid}/limits
// Document ID: "commentWrites"
// Fields:
//   - count: int (required, 1-300 comment creates and edits in the current window)
//   - windowStart: timestamp (required, server time when the window began)
//   - commentId: string (required, 1-100 chars, the comment this write counts)
//   - updatedAt: timestamp (required, server time on every write)
//   Caps how many comment writes one reader can make per day, so a script can't
//   use up the project's free daily write quota. A write either adds 1 within
//   the window, or, a day after windowStart, starts a new window at 1.
//   Only the approved owner can read and write it; it is never deleted.
//
// Collection: book
// Document ID: "meta"
// Fields:
//   - title: string (1-200), author: string (0-200), dedication: string (0-5000)
//   - chapters: list (<= 300) of { id, title, order, paragraphCount }
//   - updatedAt: timestamp (server time)
//   Readable by approved users and admins; writable by admins only.
//
// Collection: chapters
// Document ID: slug (e.g. "chapter-1")
// Fields:
//   - title: string (1-200)
//   - order: int (0-1000)
//   - paragraphs: list of HTML-escaped strings (1-5000 items)
//   - breaks: list of ints (0-5000 items) — paragraph indexes preceded by a scene break
//   Readable by approved users; writable by admins only.
//   Note: rules cannot iterate lists, so individual paragraph strings are
//   validated by the admin upload page, and the reader app re-sanitizes them.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Approval and admin flags live on the user's own profile document,
    // which clients can never modify after creation.
    function isApproved() {
      return isAuthenticated()
        && exists(userPath())
        && get(userPath()).data.approved == true;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(userPath())
        && get(userPath()).data.admin == true;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isStringWithin(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // Profile photos may only point at Google's avatar host, so the admin page
    // never loads an image from a server a reader controls.
    function isGooglePhotoUrl(value) {
      return value == ''
        || (isStringWithin(value, 1, 500)
          && value.matches('^https://lh3\\.googleusercontent\\.com/.*$'));
    }

    function isVerifiedGoogleUser() {
      return request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    // Bootstrap admin: setup.sh fills in the placeholder below with the author's
    // (lowercased) Google email when it deploys. The placeholder matches no
    // real account, so a copy deployed without setup.sh has no bootstrap admin.
    function isSiteOwner() {
      return isVerifiedGoogleUser()
        && request.auth.token.get('email', '').lower() == '__OWNER_EMAIL__';
    }

    function commentQuotaPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid)/limits/commentWrites;
    }

    // True when this same request (batch) also advances the comment quota for
    // this comment. Naming the comment stops one +1 from covering a whole batch
    // of comments. The quota document's own rules make sure the advance is a valid +1.
    function advancesCommentQuota(commentId) {
      return existsAfter(commentQuotaPath())
        && getAfter(commentQuotaPath()).data.updatedAt == request.time
        && getAfter(commentQuotaPath()).data.commentId == commentId;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      let fields = ['displayName', 'email', 'photoURL', 'approved', 'admin', 'createdAt'];
      return hasOnlyAllowedFields(fields)
        && hasRequiredFields(fields)
        && isStringWithin(data.displayName, 0, 100)
        && isStringWithin(data.email, 0, 254)
        && isGooglePhotoUrl(data.photoURL)
        && data.approved is bool
        && data.admin is bool
        && data.createdAt is timestamp;
    }

    function isValidComment(data) {
      let fields = ['chapterId', 'paragraphIndex', 'text', 'createdAt', 'updatedAt'];
      return hasOnlyAllowedFields(fields)
        && hasRequiredFields(fields)
        && isStringWithin(data.chapterId, 1, 100)
        && data.paragraphIndex is int
        && data.paragraphIndex >= 0
        && data.paragraphIndex <= 5000
        && isStringWithin(data.text, 1, 2000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Must match MAX_COMMENT_WRITES_PER_DAY in js/comments.js.
    function isValidCommentQuota(data) {
      let fields = ['count', 'windowStart', 'commentId', 'updatedAt'];
      return hasOnlyAllowedFields(fields)
        && hasRequiredFields(fields)
        && data.count is int
        && data.count >= 1
        && data.count <= 300
        && data.windowStart is timestamp
        && data.windowStart <= request.time
        && isStringWithin(data.commentId, 1, 100)
        && data.updatedAt == request.time;
    }

    function startsNewQuotaWindow(data) {
      return data.count == 1 && data.windowStart == request.time;
    }

    function isValidMeta(data) {
      let fields = ['title', 'author', 'dedication', 'chapters', 'updatedAt'];
      return hasOnlyAllowedFields(fields)
        && hasRequiredFields(fields)
        && isStringWithin(data.title, 1, 200)
        && isStringWithin(data.author, 0, 200)
        && isStringWithin(data.dedication, 0, 5000)
        && data.chapters is list
        && data.chapters.size() <= 300
        && data.updatedAt == request.time;
    }

    function isValidChapter(data) {
      let fields = ['title', 'order', 'paragraphs', 'breaks'];
      return hasOnlyAllowedFields(fields)
        && hasRequiredFields(fields)
        && isStringWithin(data.title, 1, 200)
        && data.order is int
        && data.order >= 0
        && data.order <= 1000
        && data.paragraphs is list
        && data.paragraphs.size() >= 1
        && data.paragraphs.size() <= 5000
        && data.breaks is list
        && data.breaks.size() <= 5000;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // Users can only see their own profile (it contains their email).
      // Admins can list all profiles to manage approvals.
      allow read: if isOwner(userId) || isAdmin();

      // First login: create own profile, approved by default and non-admin
      // (only the verified site owner may start as admin),
      // with the real sign-in email and server timestamp. Only verified Google
      // accounts qualify, so enabling another sign-in method can't grant access.
      allow create: if isOwner(userId)
        && isVerifiedGoogleUser()
        && isValidUser(request.resource.data)
        && request.resource.data.approved == true
        && (request.resource.data.admin == false || isSiteOwner())
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.createdAt == request.time;

      // Admins can grant or revoke approval and nothing else.
      // The admin flag itself is managed only from the Firebase console.
      allow update: if isAdmin()
        && isValidUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);

      allow delete: if false;

      match /comments/{commentId} {
        allow read: if isOwner(userId) && isApproved();

        allow create: if isOwner(userId)
          && isApproved()
          && isValidComment(request.resource.data)
          && request.resource.data.createdAt == request.time
          && advancesCommentQuota(commentId);

        allow update: if isOwner(userId)
          && isApproved()
          && isValidComment(request.resource.data)
          && advancesCommentQuota(commentId)
          && areImmutableFieldsUnchanged(['chapterId', 'paragraphIndex', 'createdAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']);

        // Approved owners delete their own; admins can remove any comment (spam cleanup).
        allow delete: if (isOwner(userId) && isApproved()) || isAdmin();
      }

      match /limits/{limitId} {
        allow read: if isOwner(userId) && isApproved();

        allow create: if isOwner(userId)
          && isApproved()
          && limitId == 'commentWrites'
          && isValidCommentQuota(request.resource.data)
          && startsNewQuotaWindow(request.resource.data);

        // +1 within the current window, or a fresh window once a day has passed.
        allow update: if isOwner(userId)
          && isApproved()
          && limitId == 'commentWrites'
          && isValidCommentQuota(request.resource.data)
          && (
            (request.resource.data.windowStart == resource.data.windowStart
              && request.resource.data.count == resource.data.count + 1)
            || (request.time > resource.data.windowStart + duration.value(1, 'd')
              && startsNewQuotaWindow(request.resource.data))
          );

        allow delete: if false;
      }
    }

    match /book/{docId} {
      allow read: if isApproved() || isAdmin();
      allow create, update: if docId == 'meta' && isAdmin() && isValidMeta(request.resource.data);
      allow delete: if isAdmin();
    }

    match /chapters/{chapterId} {
      allow read: if isApproved() || isAdmin();
      allow create, update: if isAdmin()
        && chapterId.size() <= 100
        && isValidChapter(request.resource.data);
      allow delete: if isAdmin();
    }

    // Admins can read every reader's comments (collection group query).
    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }

    // Everything else is denied by default.
  }
}
